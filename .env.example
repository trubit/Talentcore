# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/talentcore

# Admin Authentication
ADMIN_PASSWORD=change-this-in-production
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=info@talentcore.io

# Cloudflare R2 / S3 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=talentcore-uploads
R2_PUBLIC_URL=https://uploads.talentcore.io

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

